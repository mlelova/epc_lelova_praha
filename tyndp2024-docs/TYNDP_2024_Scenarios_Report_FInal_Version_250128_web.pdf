   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">1500010251</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>smart</rdf:li>
     <rdf:li>future</rdf:li>
